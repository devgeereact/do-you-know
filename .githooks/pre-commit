#!/bin/sh
# Pre-commit: project guard (guard.py) + secret scan (gitleaks).
# Enabled automatically by `pnpm install` (prepare script sets core.hooksPath).
set -eu
root=$(git rev-parse --show-toplevel)
python3 "$root/scripts/guard.py"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (macOS: brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --pre-commit --redact --staged --no-banner

# Do You Know — SERVER-ONLY secrets for Supabase Edge Functions.
# Never put these in the root .env (that file ships to the browser).
# Set them with:   supabase secrets set --env-file supabase/functions/.env
# Copy this file to supabase/functions/.env (git-ignored) and fill in real values.

# OpenRouter — text model drafts questions, image model paints avatars.
# Model ids are chosen in the CMS (site_config.ai_models), not here.
OPENROUTER_API_KEY=""

# ImageKit private key — upload generated avatars to /avatars/
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# Inngest — signing key verifies calls into the `inngest` function.
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# Site rebuild — shared secret checked by `trigger-rebuild` (same value stored in
# Supabase Vault as 'rebuild_hook_secret'), and a fine-grained GitHub token allowed to
# send repository_dispatch to this repo.
REBUILD_HOOK_SECRET=""
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO="owner/do-you-know"

# Provided automatically inside Supabase Edge Functions:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# =====================================================================
# Do You Know — SERVER-ONLY secrets for Supabase Edge Functions.
#
# Never prefix private settings with VITE_: those settings can ship to the browser.
# Copy this file to supabase/functions/.env (git-ignored), fill in real values,
# then push them to the project:
#
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
#   supabase secrets list --project-ref <ref>      # names only, values stay hidden
#
# Provided automatically inside Supabase Edge Functions (do NOT set):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
# =====================================================================


# ── NEEDED NOW: avatars (Edge Function `inngest` → job `generate-avatar`) ──

# OpenRouter: paints the avatar (image model) and runs the yes/no safety check
# (text model). Model ids are NOT set here; they live in site_config.ai_models
# (image after migration 0008: google/gemini-3.1-flash-image;
# text: openai/gpt-4o-mini). Image requests prefer the lowest-priced provider.
# Get it: openrouter.ai → Keys. Set a monthly spend limit on the key.
OPENROUTER_API_KEY=""

# ImageKit: uploads finished avatars to /avatars/<user_id>/<avatar_id>.png.
# Get it: ImageKit dashboard → Developer options → API keys (the PRIVATE key).
# The public key and URL endpoint go in the root .env as VITE_IMAGEKIT_*.
IMAGEKIT_PRIVATE_KEY=""

# Inngest: verifies that every call into the `inngest` function really comes from
# Inngest. Get it: Inngest dashboard → your app's environment → Signing key.
INNGEST_SIGNING_KEY=""

# Optional. Only needed if Inngest registers the wrong URL for the function.
# Production should record https://<ref>.supabase.co/functions/v1/inngest; check it
# after the first deploy and set this to https://<ref>.supabase.co only if it does not.
# INNGEST_SERVE_HOST=""


# ── LATER (Milestone 3, CMS): site rebuild after publishing ──
# Used by the `trigger-rebuild` function (not built yet).

# Shared secret checked by `trigger-rebuild`; store the SAME value in Supabase Vault:
#   select vault.create_secret('<value>', 'rebuild_hook_secret');
REBUILD_HOOK_SECRET=""

# Fine-grained GitHub token limited to this repo, allowed to send repository_dispatch.
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO="devgeereact/do-you-know"


# ── LOCAL DEVELOPMENT ONLY (never set these on the real project) ──
# Run the job against the local stack and the Inngest dev server
# (see supabase/functions/README.md):
#   INNGEST_DEV=1
#   INNGEST_BASE_URL=http://host.docker.internal:8288
#   INNGEST_SERVE_HOST=http://host.docker.internal:55421


# ── After the secrets are set ──
#   supabase functions deploy inngest --no-verify-jwt --project-ref <ref>
#   Inngest dashboard → Apps → Sync app → https://<ref>.supabase.co/functions/v1/inngest
#   Root .env (browser): set VITE_INNGEST_EVENT_KEY so the app can send avatar/requested.

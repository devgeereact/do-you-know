# Do You Know — browser environment. Every VITE_* value ships inside the public bundle,
# so only browser-safe keys belong here.

# ── App identity ────────────────────────────────────────────────
VITE_APP_NAME="Do You Know"
VITE_APP_URL="https://doyouknow.example"

# ── Supabase (anon key is browser-safe ONLY because every table has RLS) ──
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ── ImageKit (public key + URL endpoint only; private key never ships) ──
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
VITE_IMAGEKIT_PUBLIC_KEY="public_xxx"

# ── Sentry ──────────────────────────────────────────────────────
VITE_SENTRY_DSN=""

# ── Inngest (write-only event key; signing key lives server-side) ──
# Events sent from the browser: avatar/requested, questions/draft.requested
VITE_INNGEST_EVENT_KEY=""

# ── Analytics (optional; loads only after consent, cookieless for under-13s) ──
# PostHog EU project key is ingest-only (browser-safe). Leave empty to disable analytics.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Server-only secrets do NOT go here ───────────────────────────
# OpenRouter, ImageKit private key, Inngest signing key, GitHub token, rebuild secret:
# set them as Supabase Edge Function secrets — see supabase/functions/.env.example

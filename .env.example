# Do You Know — browser environment. Every VITE_* value ships inside the public bundle,
# so only browser-safe keys belong here.

# ── App identity ────────────────────────────────────────────────
VITE_APP_NAME="Do You Know"
# Canonical site URL (SEO, prerender, sitemap). Challenge links use the page's own origin.
VITE_APP_URL="https://doyouknow.example"

# Clerk adult accounts. Use application app_3KkAGkEUg8ST1ts6ydvb9DWKhI9.
# Pull its development configuration through the authenticated Clerk CLI.
# CLERK_SECRET_KEY must never have a VITE_ prefix or enter the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=""

# Do You Know: browser settings. Every VITE_ value ends up in the public app.
# Never put a secret here. Server secrets live only in cPanel config.php.

# Required
VITE_CPANEL_API_URL=https://doyouknow.soulrefresh.net/api/v1
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional (leave empty to switch off)
VITE_SENTRY_DSN=
VITE_IMAGEKIT_URL_ENDPOINT=
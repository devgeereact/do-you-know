# Do You Know — browser environment. Every VITE_* value ships inside the public bundle,
# so only browser-safe keys belong here.

# What the app needs today:
#   Required: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   Avatars:  VITE_INNGEST_EVENT_KEY (+ the server secrets in supabase/functions/.env.example)
#   Optional: VITE_SENTRY_DSN, VITE_IMAGEKIT_*, VITE_POSTHOG_*
# Local dev against `supabase start`: use the API URL and anon key from `supabase status`.

# ── App identity ────────────────────────────────────────────────
VITE_APP_NAME="Do You Know"
# Canonical site URL (SEO, prerender, sitemap). Challenge links use the page's own origin.
VITE_APP_URL="https://doyouknow.example"

# Clerk adult accounts. Use application app_3KkAGkEUg8ST1ts6ydvb9DWKhI9.
# Pull its development configuration through the authenticated Clerk CLI.
# CLERK_SECRET_KEY must never have a VITE_ prefix or enter the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=""

# Optional PHP practice preview. Existing game services are not switched by this.
VITE_CPANEL_API_URL="/api/v1"

# ── Supabase (anon key is browser-safe ONLY because every table has RLS) ──
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# ── ImageKit (public key + URL endpoint only; private key never ships) ──
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"
VITE_IMAGEKIT_PUBLIC_KEY="public_xxx"

# ── Sentry ──────────────────────────────────────────────────────
VITE_SENTRY_DSN=""

# ── Inngest (write-only event key; signing key lives server-side) ──
# Events sent from the browser: avatar/requested, questions/draft.requested
# Needed for avatars: without it, avatars stay "pending" and are never painted.
# Get it: Inngest dashboard → your app's environment → Event keys.
VITE_INNGEST_EVENT_KEY=""

# ── Analytics (optional; loads only after consent, cookieless for under-13s) ──
# PostHog EU project key is ingest-only (browser-safe). Leave empty to disable analytics.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# ── Server-only secrets do NOT go here ───────────────────────────
# OpenRouter, ImageKit private key, Inngest signing key, GitHub token, rebuild secret:
# set them as Supabase Edge Function secrets — see supabase/functions/.env.example
# Sentry upload tokens are build-only SENTRY_AUTH_TOKEN, never VITE_SENTRY_AUTH_TOKEN.
# Vite exposes only the public settings above. Do not add private VITE_* settings.

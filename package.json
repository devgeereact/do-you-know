{
  "name": "do-you-know",
  "version": "1.0.0",
  "private": true,
  "description": "Fun, fair quizzes for all ages: daily challenges, friend battles and school-subject practice.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "verify": "node scripts/release.mjs --verify",
    "release": "node scripts/release.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "bash scripts/with-local-tmp.sh vitest run",
    "test:e2e": "bash scripts/with-local-tmp.sh playwright test",
    "package:cpanel": "pnpm build && node scripts/package-cpanel.mjs",
    "check:htaccess": "bash scripts/check-htaccess.sh",
    "cron:ensure": "bash scripts/cron-ensure.sh",
    "test:cron": "bash scripts/with-local-tmp.sh bash scripts/cron-ensure.test.sh",
    "check:rebrand": "python3 scripts/check-rebrand.py",
    "dev:web": "vite",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@clerk/react": "^6.18.4",
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@sentry/react": "^8.55.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "pnpm@12.15.0"
}

# deps & build
node_modules/
dist/
dist-ssr/
*.local

# env (only .env.example is tracked)
.env
.env.*
!.env.example


# logs & editors
npm-debug.log*
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# tests
coverage/
playwright-report/
test-results/

# edge function secrets

# GEE OS scaffold extras
build/

# Playwright MCP scratch output
.playwright-mcp/

# PHP API dependencies and private runtime configuration
backend/vendor/
backend/config.php
backend/config.*.php
!backend/config.example.php
backend/.phpunit.cache/

__pycache__/

# Local caches and old release scratch
.cache/
.release-public/
*.bundle
*.patch
*.dump

# disposable local test database, configs and test-only keys (never commit)
.local-test/

# local project recovery/private state (never commit; plans and handoffs belong in docs/)
.local-state/


# graphify output if it is ever run again (never committed since 28 Oct 2026)
graphify-out/
.graphify*
*.graphify-bak

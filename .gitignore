# deps & build
node_modules/
dist/
dist-ssr/
*.local

# env (only .env.example is tracked)
.env
.env.*
!.env.example


# logs & editors
npm-debug.log*
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# tests
coverage/
playwright-report/
test-results/

# edge function secrets

# GEE OS scaffold extras
build/

# Playwright MCP scratch output
.playwright-mcp/

# PHP API dependencies and private runtime configuration
backend/vendor/
backend/config.php
backend/config.*.php
!backend/config.example.php
backend/.phpunit.cache/

__pycache__/

# Local rebrand/deployment scratch and recovery artifacts
.cache/
.release-public/
__pycache__/
*.bundle
*.patch
*.dump

# disposable local test database, configs and test-only keys (never commit)
.local-test/

# local project recovery/private state (never commit; plans and handoffs belong in docs/)
.local-state/

# graphify derived/local files (graph.json and the report are committed)
graphify-out/cache/
.graphify-setup-done
*.graphify-bak

# Generated helper output (run /graphify on demand; never committed)
graphify-out/
.graphify*
